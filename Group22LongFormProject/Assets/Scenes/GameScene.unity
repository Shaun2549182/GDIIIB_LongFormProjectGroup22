  act1AssemblySentenceTemplate: In the modern day, {Character} is a {Place}.
  defaultOutcome:
    characterWord: Default
    placeWord: Default
    displayStory: The hero set out on an unexpected journey.
    act2Template: Later that day, {Character} needed to find a {Place}.
    act2CharacterWords:
    - Key
    - Map
    - Compass
    act2PlaceWords:
    - Quickly
    - Carefully
    - Secretly
    - Quietly
  narrativeOutcomes:
  - characterWord: Liam
    placeWord: Officer
    displayStory: Liam works as a police officer, though he is clumsy and tends to
      spill coffee on himself during patrol.
    act2Template: Officer Liam must {Place} search the police station to recover
      his lost {Character}.
    act2CharacterWords:
    - Coffee Cup
    - Handcuffs
    - Notebook
    act2PlaceWords:
    - Clumsily
    - Hastily
    - Accidentally
    - Nervously
  - characterWord: Liam
    placeWord: Baker
    displayStory: Liam works as a baker, though his clumsiness often leaves him covered
      head-to-toe in flour.
    act2Template: Baker Liam needs to {Place} gather ingredients to bake a huge {Character}.
    act2CharacterWords:
    - Rolling Pin
    - Flour Bag
    - Oven Mitt
    act2PlaceWords:
    - Clumsily
    - Hurriedly
    - Awkwardly
    - Carelessly
  - characterWord: Ben
    placeWord: Officer
    displayStory: Ben serves as the town officer, taking his duties very seriously
      while insisting on wearing cool sunglasses indoors.
    act2Template: Officer Ben decides to {Place} inspect the alley using his trusty
      {Character}.
    act2CharacterWords:
    - Magnifying Glass
    - Secret File
    - Flashlight
    act2PlaceWords:
    - Curiously
    - Secretly
    - Quietly
    - Eagerly
  - characterWord: Ben
    placeWord: Baker
    displayStory: Ben works as a master baker, famous for crafting amazingly cool
      pastry sculptures.
    act2Template: Baker Ben wants to {Place} mix his baking dough with a mysterious
      {Character}.
    act2CharacterWords:
    - Recipe Book
    - Mystery Spice
    - Pastry Cutter
    act2PlaceWords:
    - Curiously
    - Experimentally
    - Boldly
    - Inquisitively
  - characterWord: Emma
    placeWord: Officer
    displayStory: Emma is a quick-thinking neighborhood officer who keeps the town
      safe with a friendly smile.
    act2Template: Officer Emma plans to {Place} scan the precinct room to locate
      the golden {Character}.
    act2CharacterWords:
    - Police Badge
    - Evidence Bag
    - Walkie-Talkie
    act2PlaceWords:
    - Diligently
    - Thoroughly
    - Carefully
    - Methodically
  - characterWord: Emma
    placeWord: Baker
    displayStory: Emma runs a cozy bakery, waking up at dawn every morning to bake
      sweet, fluffy buns for the locals.
    act2Template: Baker Emma will {Place} prepare her special morning order using
      her custom {Character}.
    act2CharacterWords:
    - Golden Whisk
    - Custom Cake
    - Bread Basket
    act2PlaceWords:
    - Diligently
